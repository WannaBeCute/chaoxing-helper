{
  "manifest_version": 3,
  "name": "超星辅助助手",
  "version": "1.2.9",
  "description": "兼容 Chrome / Edge 的超星作业助手：粘贴限制辅助填入、题目提取与 AI 对话。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.chaoxing.cn/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.siliconflow.cn/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.chaoxing.cn/*"],
      "js": ["vendor/marked.min.js", "vendor/purify.min.js", "vendor/highlight.min.js", "src/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.chaoxing.cn/*"],
      "js": ["src/content.js", "src/font-decode.js", "src/ai-panel.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
